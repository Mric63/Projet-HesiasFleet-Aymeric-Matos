##############################################################################
# 10. BINAIRES ET EXECUTABLES
#
# Le sujet demande le CODE SOURCE, pas les binaires : tout ceci est
# regenerable via `dotnet build` / `npm run build`.
# Si une DLL tierce doit malgre tout etre versionnee, ajouter une exception :
#   !libs/MaLibTierce.dll
##############################################################################

*.exe
*.dll
*.so
*.dylib
*.pdb
*.obj
*.o
*.a
*.lib
*.msi
*.msix
*.msm
*.msp
*.cab
*.msix


##############################################################################
# 11. ARCHIVES DE LIVRAISON
#
# Evite de commiter par erreur le zip de rendu dans le repo.
##############################################################################

*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
!docs/**/*.zip


