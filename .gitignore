##############################################################################
# .gitignore - Projet HesiasFleet (Aymeric Matos)
# A placer a la RACINE du dossier "HesiasFleet-Project Aymeric Matos"
#
# Les chemins sans "/" en debut de ligne s'appliquent a TOUS les niveaux,
# ce qui permet de couvrir HesiasFleet/ et ses sous-projets depuis la racine.
##############################################################################


##############################################################################
# 1. SECRETS ET CONFIGURATION LOCALE  --  A NE JAMAIS COMMITER
##############################################################################

# Variables d'environnement
.env
.env.*
!.env.example
*.env

# Configuration .NET locale (chaines de connexion, cles JWT, mots de passe)
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
secrets.json

# Certificats et cles
*.pfx
*.p12
*.key
*.pem
*.jks
*.keystore

# Fichiers de publication contenant potentiellement des identifiants
*.pubxml
*.pubxml.user
*.azurePubxml
*.publishsettings
PublishScripts/


##############################################################################
