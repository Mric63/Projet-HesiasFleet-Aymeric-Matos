# Copier ce fichier en « .env » à la racine du projet, puis adapter les valeurs.
# .env ne doit PAS être versionné (ajouter « .env » au .gitignore).
# Sans .env, le docker-compose.yml retombe sur ses valeurs par défaut de dev.

POSTGRES_USER=hesias
POSTGRES_PASSWORD=hesias_dev_password
POSTGRES_DB=hesiasfleet

# Clé de signature JWT : 32 caractères minimum (HMAC-SHA256).
JWT_KEY=CHANGE_ME_super_cle_secrete_de_32_caracteres_minimum_pour_signer
